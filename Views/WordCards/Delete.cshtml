@model VocabMaster.Models.WordCard

@{
    ViewData["Title"] = "Delete Card";
}

<h1>Delete Card</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Original Word
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OriginalWord)
        </dd>

        <dt class="col-sm-2">
            Translation
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Translation)
        </dd>

        <dt class="col-sm-2">
            Example Sentence
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ExampleSentence)
        </dd>

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <dt class="col-sm-2">
                Image
            </dt>
            <dd class="col-sm-10">
                <img src="@Model.ImagePath" alt="@Model.OriginalWord"
                     style="width: 100px; height: 100px; object-fit: cover; border-radius: 4px; cursor: pointer;"
                     onclick="showImageModal('@Model.ImagePath', '@Model.OriginalWord')"
                     title="Click to enlarge" />
                <small class="text-muted d-block mt-1">Click to enlarge</small>
            </dd>
        }

        <dt class="col-sm-2">
            Languages
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.LanguageFrom) → @Html.DisplayFor(model => model.LanguageTo)
        </dd>

        <dt class="col-sm-2">
            Created
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

<!-- Модальное окно для увеличенной картинки -->
<div id="imageModal" class="modal" style="display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.9);">
    <div style="position: relative; height: 100%; display: flex; align-items: center; justify-content: center;">
        <span class="close" onclick="closeImageModal()" style="position: absolute; top: 20px; right: 35px; color: white; font-size: 40px; font-weight: bold; cursor: pointer; z-index: 10001;">
            &times;
        </span>
        <img id="modalImage" style="max-width: 90%; max-height: 90%; object-fit: contain; border-radius: 8px;">
        <div id="imageCaption" style="position: absolute; bottom: 20px; color: white; text-align: center; width: 100%; font-size: 18px;"></div>
    </div>
</div>

<script>
    // Функции для модального окна
    function showImageModal(imageSrc, title) {
        const modal = document.getElementById('imageModal');
        const modalImg = document.getElementById('modalImage');
        const caption = document.getElementById('imageCaption');

        modal.style.display = "block";
        modalImg.src = imageSrc;
        caption.innerHTML = title;

        // Закрытие по ESC
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeImageModal();
            }
        });
    }

    function closeImageModal() {
        document.getElementById('imageModal').style.display = "none";
    }

    // Закрытие при клике вне картинки
    document.getElementById('imageModal').addEventListener('click', function (event) {
        if (event.target === this) {
            closeImageModal();
        }
    });
</script>